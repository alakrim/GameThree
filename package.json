{
  "name": "project-lumen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "npm run dev -w @lumen/client",
    "dev:server": "npm run dev -w @lumen/server",
    "build": "npm run build -w @lumen/client",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "test": "vitest run",
    "bench": "tsx packages/shared/bench/sim.bench.ts",
    "balance": "tsx tools/balance/run.ts"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.1.1",
    "@types/node": "^22.10.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "fflate": "^0.8.2",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
